<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/nexus_music_widget_background">

    <TextView
        android:id="@+id/nexus_music_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Nothing playing"
        android:textColor="@color/nexus_music_widget_text"
        android:textSize="16sp"
        android:textStyle="bold"
        android:contentDescription="Current song title" />

    <TextView
        android:id="@+id/nexus_music_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Enable media access to control playback"
        android:textColor="@color/nexus_music_widget_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nexus_music_access"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Media access"
            android:textColor="@color/nexus_music_widget_action"
            android:textSize="12sp"
            android:contentDescription="Open notification access settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/nexus_music_previous"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="|◀"
            android:textColor="#171717"
            android:textSize="18sp"
            android:contentDescription="Previous track" />

        <TextView
            android:id="@+id/nexus_music_play_pause"
            android:layout_width="46dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#171717"
            android:textSize="20sp"
            android:contentDescription="Play or pause playback" />

        <TextView
            android:id="@+id/nexus_music_next"
            android:layout_width="42dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="▶|"
            android:textColor="#171717"
            android:textSize="18sp"
            android:contentDescription="Next track" />
    </LinearLayout>
</LinearLayout>